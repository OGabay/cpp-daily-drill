{
  "name": "cpp-daily-drill",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "C++ Daily Drill — a daily C++ interview practice Chrome extension",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/generate-icons.mjs && tsc --noEmit && vite build && vite build -c vite.background.config.ts",
    "dev": "vite"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.77.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
